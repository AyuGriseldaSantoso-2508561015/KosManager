<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>


<StackPane style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosmanager.controller.LoginController">
   <children>
      <AnchorPane maxHeight="600.0" maxWidth="900.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F8FAFC;">
         <children>
            <Label alignment="CENTER" graphicTextGap="20.0" layoutY="90.0" prefHeight="45.0" prefWidth="900.0" style="-fx-font-weight: bold;" text="KosManager Login" textFill="#0f766e">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Label layoutX="320.0" layoutY="190.0" prefWidth="260.0" text="Username" textFill="#334155" textOverrun="CLIP">
               <font>
                  <Font name="System Bold" size="13.600000381469727" />
               </font>
            </Label>
            <Label layoutX="320.0" layoutY="280.0" prefWidth="260.0" text="Password" textFill="#334155">
               <font>
                  <Font name="System Bold" size="13.600000381469727" />
               </font>
            </Label>
            <TextField fx:id="txtUsername" layoutX="320.0" layoutY="218.0" prefWidth="260.0" promptText="Masukkan Username" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;" />
            <PasswordField fx:id="txtPassword" layoutX="320.0" layoutY="308.0" prefWidth="260.0" promptText="Masukkan Password" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />
            <Button fx:id="btnLogin" layoutX="320.0" layoutY="385.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="30.0" prefWidth="260.0" style="-fx-background-color: #0F766E; -fx-background-radius: 6;" text="Login" textFill="WHITE">
               <font>
                  <Font name="Dubai Medium" size="16.0" />
               </font>
            </Button>
            <Hyperlink fx:id="linkRegister" alignment="BOTTOM_CENTER" layoutY="450.0" onAction="#handleGoToRegister" prefWidth="1100.0" style="-fx-border-color: transparant;" text="Belum punya akun? Daftar disini" textFill="#0f766e" />
         </children>
      </AnchorPane>
   </children>
</StackPane>
