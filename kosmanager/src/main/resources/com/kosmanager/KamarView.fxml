<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="640.0" prefWidth="1000.0" spacing="16.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kosmanager.KamarController">
   <children>
      <VBox>
         <children>
            <Label prefWidth="800.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #263A38;" text="Kelola Kamar" />
            <Label style="-fx-text-fill: #263A38; -fx-font-size: 12;" text="Tambah, Lihat, Ubah, dan Hapus Data Kamar" />
         </children>
      </VBox>
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
               <children>
                  <HBox spacing="8.0">
                     <children>
                        <TextField fx:id="txtCariKamar" onKeyReleased="#handleCariFilter" promptText="Cari nomor atau tipe kamar..." HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cbFilterStatus" minWidth="130.0" onAction="#handleCariFilter" promptText="Semua Status" />
                     </children>
                  </HBox>
                  <TableView fx:id="tblKamar" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colNomor" prefWidth="90.0" text="No. Kamar" />
                        <TableColumn fx:id="colTipe" prefWidth="80.0" text="Tipe" />
                        <TableColumn fx:id="colHarga" prefWidth="160.0" text="Harga Sewa / Bulan" />
                        <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
            <VBox minWidth="280.0" prefWidth="280.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
               <children>
                  <Label style="-fx-font-size: 15; -fx-font-weight: bold;" text="Form Kamar" />
                  <VBox spacing="4.0">
                     <children>
                        <Label style="-fx-font-size: 12;" text="Nomor Kamar" />
                        <TextField fx:id="txtNomorKamar" promptText="Contoh: A01" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0">
                     <children>
                        <Label style="-fx-font-size: 12;" text="Tipe Kamar" />
                        <ComboBox fx:id="cbTipeKamar" maxWidth="1.7976931348623157E308" onAction="#handlePilihTipe" promptText="Pilih Tipe" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0">
                     <children>
                        <Label style="-fx-font-size: 12;" text="Harga Sewa / Bulan (Rp)" />
                        <TextField fx:id="txtHargaSewa" promptText="Contoh: 800000" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0">
                     <children>
                        <Label style="-fx-font-size: 12;" text="Biaya Fasilitas VIP (Rp)" />
                        <TextField fx:id="txtBiayaFasilitas" promptText="Khusus VIP" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Status" />
                        <ComboBox fx:id="cbStatusKamar" maxWidth="1.7976931348623157E308" promptText="Pilih Status" />
                     </children>
                  </VBox>
                  <Button fx:id="btnTambahKamar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleTambah" style="-fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Tambah" />
                  <Button fx:id="btnUbahKamar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUbah" style="-fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Ubah" />
                  <Button fx:id="btnHapusKamar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleHapus" style="-fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Hapus" />
                  <Button fx:id="btnBersihkanKamar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleBersihkan" style="-fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Bersihkan" />
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
</VBox>