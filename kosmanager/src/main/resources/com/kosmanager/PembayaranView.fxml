<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640" prefWidth="1000" spacing="16" style="-fx-background-color: #F4F6FA;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosmanager.PembayaranController">
   <padding>
      <Insets bottom="20" left="24" right="24" top="20" />
   </padding>
   <VBox spacing="2">
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1F2A44;" text="Pembayaran dan Riwayat" />
      <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Catat pembayaran, ubah status, dan cetak struk" />
   </VBox>
   <HBox spacing="16" VBox.vgrow="ALWAYS">
      <VBox minWidth="320" prefWidth="320" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
         <padding>
            <Insets bottom="16" left="16" right="16" top="16" />
         </padding>
         <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Catat Pembayaran" />
         <VBox spacing="4">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Transaksi" />
            <ComboBox fx:id="cbTransaksi" maxWidth="Infinity" onAction="#handlePilihTransaksi" promptText="Pilih transaksi" />
         </VBox>
         <HBox spacing="12">
            <Label fx:id="lblTagihan" style="-fx-text-fill: #475569;" text="Tagihan: Rp0" />
            <Label fx:id="lblSisa" style="-fx-font-weight: bold; -fx-text-fill: #DC2626;" text="Sisa: Rp0" />
         </HBox>
         <VBox spacing="4">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Jumlah Bayar (Rp)" />
            <TextField fx:id="txtJumlahBayar" promptText="Contoh: 2400000" />
         </VBox>
         <VBox spacing="4">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Tanggal Bayar" />
            <DatePicker fx:id="dpTanggalBayar" maxWidth="Infinity" />
         </VBox>
         <VBox spacing="4">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Metode Pembayaran" />
            <ComboBox fx:id="cbMetode" maxWidth="Infinity" promptText="Pilih metode">
               <items>
                  <FXCollections fx:factory="observableArrayList">
                     <String fx:value="Tunai" />
                     <String fx:value="Transfer" />
                     <String fx:value="QRIS" />
                  </FXCollections>
               </items>
            </ComboBox>
         </VBox>
         <VBox spacing="4">
            <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Status" />
            <ComboBox fx:id="cbStatusBayar" maxWidth="Infinity" promptText="Pilih status">
               <items>
                  <FXCollections fx:factory="observableArrayList">
                     <String fx:value="Belum Lunas" />
                     <String fx:value="Lunas" />
                  </FXCollections>
               </items>
            </ComboBox>
         </VBox>
         <Button fx:id="btnSimpanBayar" maxWidth="Infinity" onAction="#handleSimpanBayar" style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Simpan Pembayaran" />
         <Button fx:id="btnCetakStruk" maxWidth="Infinity" onAction="#handleCetakStruk" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Cetak Struk" />
      </VBox>
      <VBox spacing="10" HBox.hgrow="ALWAYS">
         <HBox spacing="8">
            <TextField fx:id="txtCariBayar" onKeyReleased="#handleFilterData" promptText="Cari nama penyewa..." HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="cbFilterBayar" onAction="#handleFilterData" promptText="Semua status">
               <items>
                  <FXCollections fx:factory="observableArrayList">
                     <String fx:value="Semua" />
                     <String fx:value="Belum Lunas" />
                     <String fx:value="Lunas" />
                  </FXCollections>
               </items>
            </ComboBox>
         </HBox>
         <TableView fx:id="tblPembayaran" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colId" prefWidth="50" text="ID" />
               <TableColumn fx:id="colPenyewa" prefWidth="140" text="Penyewa" />
               <TableColumn fx:id="colJumlah" prefWidth="110" text="Jumlah" />
               <TableColumn fx:id="colTanggal" prefWidth="100" text="Tanggal" />
               <TableColumn fx:id="colMetode" prefWidth="90" text="Metode" />
               <TableColumn fx:id="colStatus" prefWidth="100" text="Status" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </VBox>
   </HBox>
</VBox>