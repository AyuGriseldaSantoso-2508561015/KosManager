<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.kosmanager.controller.MainController">

    <top>
        <HBox prefHeight="56.0"
              style="-fx-background-color: white;">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <Label fx:id="lblHalaman"
                   text="Dashboard"
                   prefWidth="800"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblUser" text="Hello, Admin"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="210" spacing="4"
              style="-fx-background-color: #263B50;">
            <padding>
                <Insets top="20" right="12" bottom="20" left="12"/>
            </padding>

            <Label text="KosManager"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Region prefHeight="16"/>

            <Button fx:id="btnDashboard"
                    text="Dashboard"
                    maxWidth="Infinity"
                    prefHeight="38"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>

            <Button fx:id="btnKelolaKamar"
                    text="Kelola Kamar"
                    maxWidth="Infinity"
                    prefHeight="38"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>

            <Button fx:id="btnKelolaPenyewa"
                    text="Kelola Penyewa"
                    maxWidth="Infinity"
                    prefHeight="38"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>

            <Button fx:id="btnTransaksiSewa"
                    text="Transaksi Sewa"
                    maxWidth="Infinity"
                    prefHeight="38"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>

            <Button fx:id="btnPembayaran"
                    text="Pembayaran &amp; Riwayat"
                    maxWidth="Infinity"
                    prefHeight="38"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnLogout"
                    text="Logout"
                    maxWidth="Infinity"
                    prefHeight="38"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"/>
    </center>

</BorderPane>