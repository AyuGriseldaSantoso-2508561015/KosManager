<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosmanager.controller.MainController">

    <top>
        <HBox prefHeight="56.0" style="-fx-background-color: white; -fx-border-color: #E2E8F0;">
            <padding>
                <Insets bottom="24" left="24" right="24" top="24" />
            </padding>

            <Label fx:id="lblHalaman" prefWidth="800" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Dashboard" />

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="lblUser" text="Hello, Admin" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="210" spacing="4" style="-fx-background-color: #0F766E;">
            <padding>
                <Insets bottom="20" left="12" right="12" top="20" />
            </padding>

            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="KosManager" />

            <Region prefHeight="16" />

            <Button fx:id="btnDashboard" maxWidth="Infinity" prefHeight="38" style="-fx-background-color: #0D5C56; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Dashboard" />

            <Button fx:id="btnKelolaKamar" maxWidth="Infinity" prefHeight="38" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Kelola Kamar" />

            <Button fx:id="btnKelolaPenyewa" maxWidth="Infinity" prefHeight="38" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Kelola Penyewa" />

            <Button fx:id="btnTransaksiSewa" maxWidth="Infinity" prefHeight="38" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Transaksi Sewa" />

            <Button fx:id="btnPembayaran" maxWidth="Infinity" prefHeight="38" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT;" text="Pembayaran &amp; Riwayat" />

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="btnLogout" maxWidth="Infinity" prefHeight="38" style="-fx-background-color: transparant; -fx-border-color: #5EEAD4; -fx-border-width: 1px; -fx-border-radius: 6; -fx-background-radius: 6;" text="Logout" textFill="WHITE" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F8FAFC;" />
    </center>

</BorderPane>
