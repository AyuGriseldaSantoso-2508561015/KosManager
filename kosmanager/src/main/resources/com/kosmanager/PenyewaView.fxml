<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640" prefWidth="1000" spacing="16" style="-fx-background-color: #F4F6FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kosmanager.controller.PenyewaController"><padding><Insets bottom="20" left="24" right="24" top="20" /></padding>
   <VBox spacing="2">
   <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1F2A44;" text="Kelola Penyewa" />
   <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Data identitas penyewa kos" />
</VBox>
   <HBox spacing="16" VBox.vgrow="ALWAYS">
      <VBox spacing="10" HBox.hgrow="ALWAYS">
         <TextField fx:id="txtCariPenyewa" promptText="Cari nama atau nomor WhatsApp..." />
         <TableView fx:id="tblPenyewa" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"><columns><TableColumn prefWidth="50" text="ID" /><TableColumn prefWidth="200" text="Nama" /><TableColumn prefWidth="150" text="No. WhatsApp" /><TableColumn prefWidth="170" text="No. KTP" /></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy></TableView>
      </VBox>
      <VBox minWidth="280" prefWidth="280" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
         <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Form Penyewa" />
         <VBox spacing="4">
   <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Nama Lengkap" />
   <TextField fx:id="txtNama" promptText="Nama penyewa" />
</VBox>
         <VBox spacing="4">
   <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="No. WhatsApp" />
   <TextField fx:id="txtNoWa" promptText="Contoh: 081234567890" />
</VBox>
         <VBox spacing="4">
   <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="No. KTP" />
   <TextField fx:id="txtNoKtp" promptText="16 digit" />
</VBox>
         <Button fx:id="btnTambahPenyewa" maxWidth="Infinity" style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Tambah" />
         <Button fx:id="btnUbahPenyewa" maxWidth="Infinity" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Ubah" />
         <Button fx:id="btnHapusPenyewa" maxWidth="Infinity" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Hapus" />
         <Button fx:id="btnBersihPenyewa" maxWidth="Infinity" style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Hapus Form" />
      </VBox>
   </HBox>
</VBox>
