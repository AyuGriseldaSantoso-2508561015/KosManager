<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640.0"
      prefWidth="1000.0"
      spacing="16.0"
      style="-fx-background-color: #F4F6FA;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kosmanager.controller.PenyewaController">

    <padding>
        <Insets bottom="20.0"
                left="24.0"
                right="24.0"
                top="20.0"/>
    </padding>

    <!-- JUDUL -->
    <VBox spacing="2.0">

        <children>

            <Label text="Kelola Penyewa"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1F2A44;"/>

            <Label text="Data identitas penyewa kos"
                   style="-fx-font-size: 12px; -fx-text-fill: #64748B;"/>

        </children>
    </VBox>

    <!-- KONTEN -->
    <HBox spacing="16.0" VBox.vgrow="ALWAYS">

        <children>

            <!-- TABEL PENYEWA -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">

                <children>

                    <TextField fx:id="txtCariPenyewa"
                               promptText="Cari nama atau nomor WhatsApp..."/>

                    <TableView fx:id="tblPenyewa"
                               HBox.hgrow="ALWAYS"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn prefWidth="50.0"
                                         text="ID"/>

                            <TableColumn prefWidth="200.0"
                                         text="Nama"/>

                            <TableColumn prefWidth="150.0"
                                         text="No. WhatsApp"/>

                            <TableColumn prefWidth="170.0"
                                         text="No. KTP"/>

                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>

                    </TableView>

                </children>
            </VBox>

            <!-- FORM PENYEWA -->
            <VBox minWidth="280.0"
                  prefWidth="280.0"
                  spacing="12.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                <padding>
                    <Insets bottom="16.0"
                            left="16.0"
                            right="16.0"
                            top="16.0"/>
                </padding>

                <children>

                    <Label text="Form Penyewa"
                           style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                    <VBox spacing="4.0">
                        <children>

                            <Label text="Nama Lengkap"
                                   style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>

                            <TextField fx:id="txtNama"
                                       promptText="Nama penyewa"/>

                        </children>
                    </VBox>

                    <VBox spacing="4.0">
                        <children>

                            <Label text="No. WhatsApp"
                                   style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>

                            <TextField fx:id="txtNoWa"
                                       promptText="Contoh: 081234567890"/>

                        </children>
                    </VBox>

                    <VBox spacing="4.0">
                        <children>

                            <Label text="No. KTP"
                                   style="-fx-font-size: 12px; -fx-text-fill: #475569;"/>

                            <TextField fx:id="txtNoKtp"
                                       promptText="16 digit"/>

                        </children>
                    </VBox>

                    <Button fx:id="btnTambahPenyewa"
                            maxWidth="Infinity"
                            style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Tambah"/>

                    <Button fx:id="btnUbahPenyewa"
                            maxWidth="Infinity"
                            style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Ubah"/>

                    <Button fx:id="btnHapusPenyewa"
                            maxWidth="Infinity"
                            style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Hapus"/>

                    <Button fx:id="btnBersihPenyewa"
                            maxWidth="Infinity"
                            style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="Hapus Form"/>

                </children>

            </VBox>

        </children>
    </HBox>

</VBox>
