<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosmanager.controller.RegisterController">

   <children>
      <Label layoutX="202.0" layoutY="24.0" style="-fx-font-weight: bold;" text="REGISTER AKUN KOST" textFill="#0f766e">
         <font>
            <Font size="19.0" />
         </font>
      </Label>

      <Label layoutX="115.0" layoutY="85.0" text="Username" textFill="#334155" />
      <Label layoutX="118.0" layoutY="135.0" text="Password" textFill="#334155" />
      <Label layoutX="118.0" layoutY="185.0" text="Konfirmasi Password" textFill="#334155" />

      <TextField fx:id="txtRegUsername" layoutX="267.0" layoutY="80.0" promptText="Masukkan Username" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />

      <PasswordField fx:id="txtRegPassword" layoutX="267.0" layoutY="130.0" promptText="Masukkan Password" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />

      <PasswordField fx:id="txtRegConfirmPassword" layoutX="267.0" layoutY="180.0" promptText="Konfirmasi Password" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />

      <Button fx:id="btnRegister" layoutX="267.0" layoutY="235.0" mnemonicParsing="false" onAction="#handleRegister" style="-fx-background-color: #0F766E; -fx-background-radius: 6;" text="Daftar" textFill="WHITE" />

      <Hyperlink fx:id="linkLogin" layoutX="352.0" layoutY="237.0" onAction="#handleGoToLogin" style="-fx-border-color: transparant;" text="Sudah punya akun?" textFill="#0f766e" />
   </children>
</AnchorPane>
