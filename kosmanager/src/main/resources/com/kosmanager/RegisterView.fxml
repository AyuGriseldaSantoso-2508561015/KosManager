<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>


<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosmanager.controller.RegisterController">
   <children>
      <AnchorPane maxHeight="600.0" maxWidth="900.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F8FAFC;">
      
         <children>
            <Label alignment="CENTER" layoutY="90.0" prefHeight="45.0" prefWidth="900.0" style="-fx-font-weight: bold;" text="REGISTER AKUN KOS" textFill="#0f766e">
               <font>
                  <Font size="19.0" />
               </font>
            </Label>
      
            <Label layoutX="257.0" layoutY="190.0" text="Username" textFill="#334155" />
            <Label layoutX="257.0" layoutY="255.0" text="Password" textFill="#334155" />
            <Label layoutX="257.0" layoutY="320.0" text="Konfirmasi Password" textFill="#334155" />
      
            <TextField fx:id="txtRegUsername" layoutX="447.0" layoutY="185.0" promptText="Masukkan Username" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />
      
            <PasswordField fx:id="txtRegPassword" layoutX="447.0" layoutY="250.0" promptText="Masukkan Password" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />
      
            <PasswordField fx:id="txtRegConfirmPassword" layoutX="447.0" layoutY="315.0" promptText="Konfirmasi Password" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-background-radius: 6; -fx-border-radius: 6;" />
      
            <Button fx:id="btnRegister" layoutX="447.0" layoutY="385.0" mnemonicParsing="false" onAction="#handleRegister" style="-fx-background-color: #0F766E; -fx-background-radius: 6;" text="Daftar" textFill="WHITE" />
      
            <Hyperlink fx:id="linkLogin" layoutX="540.0" layoutY="387.0" onAction="#handleGoToLogin" prefWidth="150.0" style="-fx-border-color: transparant;" text="Sudah punya akun?" textFill="#0f766e" />
         </children>
      </AnchorPane>
   </children>
</StackPane>
