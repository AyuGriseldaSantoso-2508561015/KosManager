<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="640" prefWidth="860" spacing="16" style="-fx-background-color: #F4F6FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kosmanager.controller.DashboardController"> 
   <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>
   <VBox spacing="2">
   <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1F2A44;" text="Dashboard" />
   <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Ringkasan Kondisi Kos Hari Ini" />
</VBox>
   <HBox spacing="16">
      <VBox spacing="4" style="-fx-background-color: #115E59; -fx-background-radius: 10;" HBox.hgrow="ALWAYS"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
      <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="Kamar Kosong" />
      <Label fx:id="lblKamarKosong" style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;" text="0" /></VBox>
      <VBox spacing="4" style="-fx-background-color: #0F766E; -fx-background-radius: 10;" HBox.hgrow="ALWAYS"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
      <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="Kamar Terisi" />
      <Label fx:id="lblKamarTerisi" style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;" text="0" /></VBox>
      <VBox spacing="4" style="-fx-background-color: #0D9488; -fx-background-radius: 10;" HBox.hgrow="ALWAYS"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
      <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="Total Penyewa" />
      <Label fx:id="lblTotalPenyewa" style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;" text="0" /></VBox>
      <VBox spacing="4" style="-fx-background-color: #134E4A; -fx-background-radius: 10;" HBox.hgrow="ALWAYS"><padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
      <Label style="-fx-text-fill: white; -fx-font-size: 12px;" text="Transaksi Belum Lunas" />
      <Label fx:id="lblBelumLunas" style="-fx-text-fill: white; -fx-font-size: 30px; -fx-font-weight: bold;" text="0" /></VBox>
   </HBox>
   <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1F2A44;" text="Transaksi Terbaru" />
   <TableView fx:id="tblTransaksiTerbaru" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"><columns><TableColumn prefWidth="60" text="ID" /><TableColumn prefWidth="180" text="Penyewa" /><TableColumn prefWidth="90" text="Kamar" /><TableColumn prefWidth="110.0" text="Durasi (Bulan)" /><TableColumn prefWidth="140" text="Total Biaya" /><TableColumn prefWidth="110" text="Status" /><TableColumn prefWidth="120" text="Tanggal" /></columns><columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy></TableView>
</VBox>
